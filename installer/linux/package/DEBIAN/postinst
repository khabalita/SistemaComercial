#!/bin/sh
set -e

APP_USER="sistemacomercial"
APP_GROUP="sistemacomercial"
APP_HOME="/opt/sistemacomercial"
DATA_DIR="/var/lib/sistemacomercial"
CONFIG_DIR="/etc/sistemacomercial"
CONFIG_FILE="$CONFIG_DIR/application.properties"

escape_java_property() {
    printf '%s' "$1" | sed \
        -e 's/\\/\\\\/g' \
        -e 's/ /\\ /g' \
        -e 's/:/\\:/g' \
        -e 's/=/\\=/g' \
        -e 's/#/\\#/g' \
        -e 's/!/\\!/g'
}

case "${1:-}" in
    configure)
        if ! getent passwd "$APP_USER" >/dev/null; then
            adduser --system --group --home "$DATA_DIR" --no-create-home --disabled-login "$APP_USER"
        fi

        install -d -o "$APP_USER" -g "$APP_GROUP" -m 0750 \
            "$DATA_DIR" "$DATA_DIR/product-images" "$DATA_DIR/business-assets"
        install -d -o root -g "$APP_GROUP" -m 0750 "$CONFIG_DIR"

        if [ ! -f "$CONFIG_FILE" ]; then
            . /usr/share/debconf/confmodule
            db_get sistemacomercial/admin-password
            ADMIN_PASSWORD="$RET"
            if [ "${#ADMIN_PASSWORD}" -lt 8 ]; then
                echo "La contraseña inicial del administrador debe tener al menos 8 caracteres." >&2
                exit 1
            fi

            systemctl start mysql
            mysql_ready=0
            for _ in $(seq 1 60); do
                if mysqladmin --protocol=socket --user=root ping >/dev/null 2>&1; then
                    mysql_ready=1
                    break
                fi
                sleep 1
            done
            if [ "$mysql_ready" -ne 1 ]; then
                echo "MySQL no respondió. Revise el servicio mysql e intente configurar nuevamente el paquete." >&2
                exit 1
            fi

            DB_PASSWORD="$(openssl rand -hex 32)"
            mysql --protocol=socket --user=root <<SQL
CREATE DATABASE IF NOT EXISTS sistemacomercial CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER IF NOT EXISTS 'sistema_app'@'localhost' IDENTIFIED BY '$DB_PASSWORD';
ALTER USER 'sistema_app'@'localhost' IDENTIFIED BY '$DB_PASSWORD';
GRANT ALL PRIVILEGES ON sistemacomercial.* TO 'sistema_app'@'localhost';
FLUSH PRIVILEGES;
SQL

            ADMIN_PASSWORD_ESCAPED="$(escape_java_property "$ADMIN_PASSWORD")"
            umask 027
            cat > "$CONFIG_FILE" <<EOF
spring.application.name=sistemacomercial
spring.datasource.url=jdbc:mysql://localhost:3306/sistemacomercial?serverTimezone=America/Argentina/Buenos_Aires&useSSL=false&allowPublicKeyRetrieval=true
spring.datasource.username=sistema_app
spring.datasource.password=$DB_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=false
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect
spring.jpa.open-in-view=false
spring.thymeleaf.cache=true
server.port=8081
server.address=127.0.0.1
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB
app.storage.product-images=$DATA_DIR/product-images
app.storage.business-assets=$DATA_DIR/business-assets
app.security.initial-admin-username=admin
app.security.initial-admin-password=$ADMIN_PASSWORD_ESCAPED
EOF
            db_set sistemacomercial/admin-password ""
        fi

        chown root:"$APP_GROUP" "$CONFIG_FILE"
        chmod 0640 "$CONFIG_FILE"
        systemctl daemon-reload
        systemctl enable --now sistemacomercial.service
        systemctl enable --now sistemacomercial-backup.timer
        echo "Sistema Comercial instalado. Abra http://localhost:8081/login e acceda como admin."
        ;;
esac

exit 0
